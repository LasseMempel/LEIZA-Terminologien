{
  "id": "https://www.w3id.org/archlink/terms/ceratyont-terminology/facet_publishers",
  "type": "Concept",
  "prefLabel": {
    "en": "Publishers"
  },
  "definition": {
    "en": "Facet grouping the typology publishers (Dragendorff, Conspectus, Curle, …). Each publisher has its specific potforms as narrower concepts."
  },
  "scopeNote": {
    "en": [
      "Use to attribute a Potform to the scholar or reference work that originally defined it. Potforms appear as narrower concepts under their Publisher."
    ]
  },
