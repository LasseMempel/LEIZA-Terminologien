{
  "id": "https://www.w3id.org/archlink/terms/ceratyont-terminology/service_3002",
  "type": "Concept",
  "prefLabel": {
    "en": "Service II"
  },
  "definition": {
    "en": "Samian Ware tableware service: Service II."
  },
  "note": {
    "en": [
      "display color: orange"
    ]
  },
  "scopeNote": {
    "en": [
      "Use to group Potforms that form a matching set of tableware items (plates, cups, bowls) from the same production tradition."
    ]
