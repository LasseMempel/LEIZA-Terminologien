{
  "id": "https://www.w3id.org/archlink/terms/ceratyont-terminology/publisher_4009",
  "type": "Concept",
  "prefLabel": {
    "en": "Ludowici"
  },
  "definition": {
    "en": "Publisher / typology author: Ludowici. Defines a set of named potforms."
  },
  "note": {
    "en": [
      "display color: yellow"
    ]
  },
  "scopeNote": {
    "en": [
      "Use to attribute a Potform to the scholar or reference work that originally defined it. Potforms appear as narrower concepts under their Publisher."
    ]
  },
