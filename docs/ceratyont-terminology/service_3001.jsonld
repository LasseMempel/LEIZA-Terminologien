  "type": "Concept",
  "prefLabel": {
    "en": "Service I"
  },
  "definition": {
    "en": "Samian Ware tableware service: Service I."
  },
  "note": {
    "en": [
      "display color: red"
    ]
  },
  "scopeNote": {
    "en": [
      "Use to group Potforms that form a matching set of tableware items (plates, cups, bowls) from the same production tradition."
    ]
