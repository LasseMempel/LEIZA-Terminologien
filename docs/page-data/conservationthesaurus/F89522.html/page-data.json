{"componentChunkName":"component---src-components-concept-jsx","path":"/conservationthesaurus/F89522.html","result":{"pageContext":{"node":{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/F89522","type":"Concept","prefLabel":{"en":null,"de":"Polyethylenglycol","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"altLabel":{"en":null,"de":["PEG"],"dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"hiddenLabel":null,"definition":{"en":null,"de":"synthetischer Polyether aus sich wiederholenden -CH2-CH2-O-Monomeren, der durch Polymerisation von Ethylenoxid hergestellt wird. PEG kann in verschiedenen Molekulargewichten bezogen werden, wodurch sich unterschiedliche spezifische Eigenschaften ergeben. Je länger die Molekülkette (je höher die Zahl hinter PEG), desto höher die Viskosität des PEGs. In der Konservierung und Restaurierung wird PEG hauptsächlich als Festigungsmittel für wassergelagerte organische Materialien (z.B. Holz oder Leder) verwendet. Das hygroskopische Polymer ersetzt dabei das Wasser in den Zellwänden, stabilisiert die Objektstruktur und verhindert beim Trocknungsprozess ein Schrumpfen und Reißen des Materials.","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":["F89522"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/A1D125","prefLabel":{"en":"synthetic polymer","de":"synthetisches Polymer","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null}},"broaderTransitive":null,"related":[{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/B26D29","prefLabel":{"en":null,"de":"temporäre Stabilisierung","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null}},{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/A31C7C","prefLabel":{"en":"reinforcement","de":