{"componentChunkName":"component---src-components-concept-jsx","path":"/conservationthesaurus/C2BC6C.html","result":{"pageContext":{"node":{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/C2BC6C","type":"Concept","prefLabel":{"en":null,"de":"Latexschwamm","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"altLabel":{"en":null,"de":["Latex Reinigungsschwamm","Latexschwämmchen","Trockenreinigungsschwamm"],"dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"hiddenLabel":null,"definition":{"en":null,"de":"Schwamm aus natürlichem oder synthetischem Latex, teils mit Zusätzen wie Faktis, zur mechanischen, nicht abrasiven Oberflächenreinigung. Lose aufliegende Verschmutzungen wie Staub, Ruß oder Schmutzfilme werden durch Haften am Schwammmaterial aufgenommen. Je nach Produkt geschieht das unter Krümelbildung (Radierschwamm) oder ohne Materialabgabe, wobei der Schwamm dann auswaschbar und wiederverwendbar ist. Überwiegend in der Trockenreinigung eingesetzt, teils auch feucht.","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":["C2BC6C"],"example":null,"narrower":[{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/A77D84","prefLabel":{"en":null,"de":"Wallmaster Spezial-Reinigungsschwamm","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null}},{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/DFF5D1","prefLabel":{"en":null,"de":"akapad Trockenreinigungsschwamm","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null}}],"narrowerTransitive":[],"broader":{"id":"https://www.w3id.org/archlink/terms/conservationthesaurus/A341F9","prefLabel":{"en":"sponge","de":"Schwamm","dk":null,"es":null,"fr":null,"gr":null,"it":null,"nl":null,"pl":null}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null