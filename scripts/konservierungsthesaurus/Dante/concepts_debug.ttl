<https://www.w3id.org/archlink/terms/conservationthesaurus/FF744D> a skos:Concept ;
  skos:notation "FF744D" ;
  skos:prefLabel "modernes Elfenbein"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AG55BC> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/GB6DF3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F1BA31>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AG55BC>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B626A3> ;
  skos:definition "Elfenbein, das aus der Gegenwart bzw. von kürzlich verstorbenen Tieren wie Elefanten oder Walrossen gewonnen wurde. Aufgrund von Naturschutzgesetzen und internationalen Abkommen wie dem Washingtoner Artenschutzübereinkommen (CITES) ist der Handel mit solchem Elfenbein stark eingeschränkt und verboten."@de, [
    skosxl:literalForm "Elfenbein, das aus der Gegenwart bzw. von kürzlich verstorbenen Tieren wie Elefanten oder Walrossen gewonnen wurde. Aufgrund von Naturschutzgesetzen und internationalen Abkommen wie dem Washingtoner Artenschutzübereinkommen (CITES) ist der Handel mit solchem Elfenbein stark eingeschränkt und verboten."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "modernes Elfenbein"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "frisches Elfenbein"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "frisches Elfenbein"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G56716> a skos:Concept ;
  skos:notation "G56716" ;
  skos:prefLabel "fossiles Elfenbein"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
