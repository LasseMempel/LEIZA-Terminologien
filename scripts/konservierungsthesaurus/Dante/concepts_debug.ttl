  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B5DD1A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GB5BGF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BBF566>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F7D3DB> ;
  skos:definition "bläulich-weißes Metall mit dem chemischen Symbol Zn und der Ordnungszahl 30. Zink wurde in der Antike hauptsächlich als Erz bei der Kupferverhüttung bzw. -legierung verarbeitet. Erst im späten Mittelalter wird Zink gezielt als reines Metall hergestellt."@de, [
    skosxl:literalForm "bläulich-weißes Metall mit dem chemischen Symbol Zn und der Ordnungszahl 30. Zink wurde in der Antike hauptsächlich als Erz bei der Kupferverhüttung bzw. -legierung verarbeitet. Erst im späten Mittelalter wird Zink gezielt als reines Metall hergestellt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
