    a skosxl:Label ;
    skosxl:literalForm "Gold"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "gold"@en ;
    wikibase:rank "normal"
  ] .

