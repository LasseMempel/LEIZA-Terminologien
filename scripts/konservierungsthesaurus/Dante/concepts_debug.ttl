<https://www.w3id.org/archlink/terms/conservationthesaurus/D2D671> a skos:Concept ;
  skos:notation "D2D671" ;
  skos:prefLabel "Araldite 2020"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Araldit 20/20"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AF31AG> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A1D125>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AF31AG> ;
  skos:definition "Produktname eines niedrigviskosen, bei Raumtemperatur aushärtenden Zweikomponenten-Systems auf Epoxidharzbasis der Firma Huntsman Corporation. Araldit 20/20 wird aus zwei Komponenten (Harz A und Härter B) angemischt und wurde speziell für das Kleben, Vergießen und Beschichten von Glas und ähnlichen Materialien entwickelt. Es zeichnet sich durch eine gute Haftung, Beständigkeit und hohe Transparenz aus. Araldite 20/20 zeigt eine ähnliche Lichtbrechung wie Glas, wodurch es bei der Verwendung als Glasklebstoff die geklebten Bruchkanten weniger bis kaum sichtbar erscheinen lässt."@de, [
    skosxl:literalForm "Produktname eines niedrigviskosen, bei Raumtemperatur aushärtenden Zweikomponenten-Systems auf Epoxidharzbasis der Firma Huntsman Corporation. Araldit 20/20 wird aus zwei Komponenten (Harz A und Härter B) angemischt und wurde speziell für das Kleben, Vergießen und Beschichten von Glas und ähnlichen Materialien entwickelt. Es zeichnet sich durch eine gute Haftung, Beständigkeit und hohe Transparenz aus. Araldite 20/20 zeigt eine ähnliche Lichtbrechung wie Glas, wodurch es bei der Verwendung als Glasklebstoff die geklebten Bruchkanten weniger bis kaum sichtbar erscheinen lässt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Araldit 20/20"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
