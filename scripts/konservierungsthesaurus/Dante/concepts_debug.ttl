<https://www.w3id.org/archlink/terms/conservationthesaurus/AFC696> a skos:Concept ;
  skos:notation "AFC696" ;
  skos:prefLabel "2-Butanon"@de, "ethyl methyl ketone"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Butanon"@de, "MEK"@de, "Methyl Ethyl Keton"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "organische Verbindung mit der chemischen Formel C4H8O aus der Gruppe der Ketone. Es ist eine farblose, flüchtige Flüssigkeit mit charakteristischem Geruch, die sich durch eine moderate Polarität und hohe Lösekraft sowie eine Verdunstungsgeschwindigkeit zwischen Aceton und Ethanol auszeichnet, wodurch es in der Konservierung und Restaurierung zur Entfernung von Beschichtungen, Klebstoffen und zur Herstellung von Polymerlösungen verwendet wird."@de, [
    skosxl:literalForm "organische Verbindung mit der chemischen Formel C4H8O aus der Gruppe der Ketone. Es ist eine farblose, flüchtige Flüssigkeit mit charakteristischem Geruch, die sich durch eine moderate Polarität und hohe Lösekraft sowie eine Verdunstungsgeschwindigkeit zwischen Aceton und Ethanol auszeichnet, wodurch es in der Konservierung und Restaurierung zur Entfernung von Beschichtungen, Klebstoffen und zur Herstellung von Polymerlösungen verwendet wird."@de
  ] ;
