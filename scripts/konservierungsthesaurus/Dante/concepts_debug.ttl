  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAC996>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A7B171>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AF5B1A> ;
  skos:definition "Korrosionserscheinung, die örtlich begrenzt zur Spaltbildung zwischen Oberflächen führt."@de, [
    skosxl:literalForm "Korrosionserscheinung, die örtlich begrenzt zur Spaltbildung zwischen Oberflächen führt."@de
