<https://www.w3id.org/archlink/terms/conservationthesaurus/D74CG7> a skos:Concept ;
  skos:notation "D74CG7" ;
  skos:prefLabel "aufgezogen"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/D18BBG> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D18BBG>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:definition "Treibtechnik, bei der ein Blech durch gezielte und genau dosierte Hammerschläge so gestaucht wird, dass sich sein Rand zwangsweise nach oben und innen wölbt. Auf diese Weise wird durch sich ständig wiederholendes Stauchen und Strecken ein Hohlkörper gebildet, dessen Ausgestaltung \"frei Hand\" geformt wird. Die Bearbeitung erfolgt dabei auf weicher (Holz) oder harter (Stahl) Unterlage, ohne Gegenform, die die endgültige Form des Hohlkörpers vorgibt."@de, [
    skosxl:literalForm "Treibtechnik, bei der ein Blech durch gezielte und genau dosierte Hammerschläge so gestaucht wird, dass sich sein Rand zwangsweise nach oben und innen wölbt. Auf diese Weise wird durch sich ständig wiederholendes Stauchen und Strecken ein Hohlkörper gebildet, dessen Ausgestaltung \"frei Hand\" geformt wird. Die Bearbeitung erfolgt dabei auf weicher (Holz) oder harter (Stahl) Unterlage, ohne Gegenform, die die endgültige Form des Hohlkörpers vorgibt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "aufgezogen"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Aufziehen"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Aufziehen"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D1F5D3> a skos:Concept ;
  skos:notation "D1F5D3" ;
  skos:prefLabel "gefasst"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:definition "Verzierungstechnik, bei der die Objektoberfläche mit einer farbigen Schicht aus Farbpigmenten und/oder Blattgold/Blattsilber überzogen ist. Unter der farbigen Schicht wurde die Oberfläche meist mit einer Grundiermasse aus Kreide oder Gips und Leim geglättet bzw. plastische Details darauf modelliert. Der Begriff wird häufig im Kontext von Holzskulpturen mit bunter Bemalung verwendet."@de, [
    skosxl:literalForm "Verzierungstechnik, bei der die Objektoberfläche mit einer farbigen Schicht aus Farbpigmenten und/oder Blattgold/Blattsilber überzogen ist. Unter der farbigen Schicht wurde die Oberfläche meist mit einer Grundiermasse aus Kreide oder Gips und Leim geglättet bzw. plastische Details darauf modelliert. Der Begriff wird häufig im Kontext von Holzskulpturen mit bunter Bemalung verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "gefasst"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Farbfassung"@de, "Fassung"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Fassung"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Farbfassung"@de ;
    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D1GC4D> a skos:Concept ;
  skos:notation "D1GC4D" ;
  skos:prefLabel "Alabaster"@de ;
