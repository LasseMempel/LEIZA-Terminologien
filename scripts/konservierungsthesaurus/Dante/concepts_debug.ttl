    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/C81F4D> a skos:Concept ;
  skos:notation "C81F4D" ;
  skos:prefLabel "Calcedon"@de, "calcedony"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
