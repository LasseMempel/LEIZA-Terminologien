<https://www.w3id.org/archlink/terms/conservationthesaurus/ADB89D> a skos:Concept ;
  skos:notation "ADB89D" ;
  skos:prefLabel "gespalten"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:definition "Trennvorgang an Materialen (z.B Holz, Stein) oft unter Nutzung natürlicher Schwachstellen/Wachstumslinien/Sedimentlagern. Bei Holz wird der Spaltvorgang radial ausgeführt und folgt den Wachstumsstrukturen (Holzstrahlen). Daher werden die Holzstrahlen nicht verletzt/getrennt wie beim Sägen, das gewonnene Werkstück ist besonders stabil und bruchfest."@de, [
    skosxl:literalForm "Trennvorgang an Materialen (z.B Holz, Stein) oft unter Nutzung natürlicher Schwachstellen/Wachstumslinien/Sedimentlagern. Bei Holz wird der Spaltvorgang radial ausgeführt und folgt den Wachstumsstrukturen (Holzstrahlen). Daher werden die Holzstrahlen nicht verletzt/getrennt wie beim Sägen, das gewonnene Werkstück ist besonders stabil und bruchfest."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "gespalten"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Spalten"@de, "Spaltung"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Spaltung"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Spalten"@de ;
    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/AF49C1> a skos:Concept ;
  skos:notation "AF49C1" ;
  skos:prefLabel "patiniert"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:definition "Verzierungstechnik, bei der die Oberfläche von Kupfer bzw. Kupferlegierungen durch chemische, thermische oder natürliche Prozesse gezielt verändert wird, um eine farbige oder gealterte Optik zu erzielen. Dies geschieht häufig durch den Einsatz von Säuren, Oxidationsmitteln oder durch gezielte Alterung unter Umwelteinflüssen. Die so entstehende Patina dient nicht nur dekorativen Zwecken, sondern kann auch als Schutzschicht gegen Korrosion wirken."@de, [
    skosxl:literalForm "Verzierungstechnik, bei der die Oberfläche von Kupfer bzw. Kupferlegierungen durch chemische, thermische oder natürliche Prozesse gezielt verändert wird, um eine farbige oder gealterte Optik zu erzielen. Dies geschieht häufig durch den Einsatz von Säuren, Oxidationsmitteln oder durch gezielte Alterung unter Umwelteinflüssen. Die so entstehende Patina dient nicht nur dekorativen Zwecken, sondern kann auch als Schutzschicht gegen Korrosion wirken."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "patiniert"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Paninierung"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Paninierung"@de ;
    wikibase:rank "preferred"
  ] .

