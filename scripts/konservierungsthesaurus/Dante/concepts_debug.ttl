  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CD3341>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F3G8D1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9A858>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DFG875>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7DD6B> ;
  skos:definition "Holz der Erlen. Das leichte bis mittelschwere Holz zeigt direkt nach dem Fällen eine rötlich- orange Färbung, die durch die Oxidation mit Luftsauerstoff allmählich rötlichweiß bis rötlichbraun nachdunkelt. Die Maserung ist fein und schlicht und das Holz von geringer Härte, wodurch es mit allen Werkzeugen gut bearbeitbar ist."@de, [
    skosxl:literalForm "Holz der Erlen. Das leichte bis mittelschwere Holz zeigt direkt nach dem Fällen eine rötlich- orange Färbung, die durch die Oxidation mit Luftsauerstoff allmählich rötlichweiß bis rötlichbraun nachdunkelt. Die Maserung ist fein und schlicht und das Holz von geringer Härte, wodurch es mit allen Werkzeugen gut bearbeitbar ist."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Erlenholz"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "alder"@en ;
    wikibase:rank "normal"
  ] ;
  skos:altLabel "Alnus glutinosa"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Alnus glutinosa"@de ;
    wikibase:rank "preferred"
  ] .

