<https://www.w3id.org/archlink/terms/conservationthesaurus/B59296> a skos:Concept ;
  skos:notation "B59296" ;
  skos:prefLabel "Zahn"@de, "tooth"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
