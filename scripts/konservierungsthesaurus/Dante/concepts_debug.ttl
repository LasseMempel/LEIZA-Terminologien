  skos:definition "Verzierungsmethode, bei der Glas bzw. eine glasartige Matrix auf eine Metalloberfläche oder in vorbereitete Zellen auf- bzw. eingeschmolzen wird."@de, [
    skosxl:literalForm "Verzierungsmethode, bei der Glas bzw. eine glasartige Matrix auf eine Metalloberfläche oder in vorbereitete Zellen auf- bzw. eingeschmolzen wird."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/CG8188>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D27B9A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DA226G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/FB5C1F>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G1A3FB>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G53328> ;
