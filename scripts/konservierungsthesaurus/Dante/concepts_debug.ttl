<https://www.w3id.org/archlink/terms/conservationthesaurus/CAD229> a skos:Concept ;
  skos:notation "CAD229" ;
  skos:prefLabel "Ahornholz"@de, "maple"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CD3341>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F3G8D1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9A858>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DFG875>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7DD6B> ;
  skos:definition "Holz des Ahornbaumes. Ahornholz ist ein schweres, hartes Holz, das eine helle, weiß bis gelbliche, im frisch geschlagenen Zustand auch rötliche Färbung sowie eine feine, gleichmäßige Maserung aufweist. Es zeigt eine glatte und feinporige Textur, hohe Elastizität und Biegefestigkeit sowie gute Bearbeitbarkeit mit verschiedenen Werkzeugen."@de, [
    skosxl:literalForm "Holz des Ahornbaumes. Ahornholz ist ein schweres, hartes Holz, das eine helle, weiß bis gelbliche, im frisch geschlagenen Zustand auch rötliche Färbung sowie eine feine, gleichmäßige Maserung aufweist. Es zeigt eine glatte und feinporige Textur, hohe Elastizität und Biegefestigkeit sowie gute Bearbeitbarkeit mit verschiedenen Werkzeugen."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Ahornholz"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "maple"@en ;
    wikibase:rank "normal"
  ] ;
  skos:altLabel "Acer campestre"@de ;
  skosxl:altLabel [
