    skosxl:literalForm "twist"@en ;
    wikibase:rank "normal"
  ] ;
  skos:altLabel "Verdrillen"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Verdrillen"@de ;
    wikibase:rank "preferred"
  ] .

