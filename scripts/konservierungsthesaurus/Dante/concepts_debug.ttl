    skosxl:literalForm "Araldite 2020"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D38147> a skos:Concept ;
  skos:notation "D38147" ;
  skos:prefLabel "Hxtal NYL-1"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AF31AG> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A1D125>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AF31AG> ;
  skos:definition "Produktname eines Epoxidklebstoffes der in den 80er Jahren von Herber Hillary, in Zusammenarbeit mit den Laboratorien von Texaco und Shell, speziell für die Konservierung und Restaurierung entwickelt wurde. Es wird, anders als die meisten anderen Epoxidharze, durch die Reaktion eines cycloaliphatischen Epoxidharzes mit einer Mischung von Aminen als Härter synthetisiert. Hxtal NYL-01 wurde insbesondere für die Klebung und Ergänzung von Gläsern und Keramiken hergestellt und zeigt einen ähnlichen Brechungsindex wie die meisten Gläser."@de, [
    skosxl:literalForm "Produktname eines Epoxidklebstoffes der in den 80er Jahren von Herber Hillary, in Zusammenarbeit mit den Laboratorien von Texaco und Shell, speziell für die Konservierung und Restaurierung entwickelt wurde. Es wird, anders als die meisten anderen Epoxidharze, durch die Reaktion eines cycloaliphatischen Epoxidharzes mit einer Mischung von Aminen als Härter synthetisiert. Hxtal NYL-01 wurde insbesondere für die Klebung und Ergänzung von Gläsern und Keramiken hergestellt und zeigt einen ähnlichen Brechungsindex wie die meisten Gläser."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Hxtal NYL-1"@de
  ] .

