<https://www.w3id.org/archlink/terms/conservationthesaurus/G56866> a skos:Concept ;
  skos:notation "G56866" ;
  skos:prefLabel "engobiert"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:definition "Verzierungstechnik an Keramikobjekten, bei der der Keramikscherben mit einer Engobe - d.h. einer dünnen Beschichtung einer andersfarbigen oder qualitätvolleren Keramik überzogen wurde. Dies kann z.B. zum Zwecke haben einen \"minderwertigeren\" Ton zu überdecken oder eine homogene Grundlage für eine anschließende Bemalung zu schaffen. Hierzu wird entweder das gesamte Gefäß in einen dünnen Tonschlicker getaucht oder dieser gezielt auf das Objekt aufgetragen. Durch einen anschließenden Brand versintert die Tonschlickerschicht und es entsteht eine dichte Engobe auf der Scherbenoberfläche."@de, [
    skosxl:literalForm "Verzierungstechnik an Keramikobjekten, bei der der Keramikscherben mit einer Engobe - d.h. einer dünnen Beschichtung einer andersfarbigen oder qualitätvolleren Keramik überzogen wurde. Dies kann z.B. zum Zwecke haben einen \"minderwertigeren\" Ton zu überdecken oder eine homogene Grundlage für eine anschließende Bemalung zu schaffen. Hierzu wird entweder das gesamte Gefäß in einen dünnen Tonschlicker getaucht oder dieser gezielt auf das Objekt aufgetragen. Durch einen anschließenden Brand versintert die Tonschlickerschicht und es entsteht eine dichte Engobe auf der Scherbenoberfläche."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "engobiert"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Engobe"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Engobe"@de ;
    wikibase:rank "preferred"
  ] .

