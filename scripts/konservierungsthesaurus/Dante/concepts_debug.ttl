    a skosxl:Label ;
    skosxl:literalForm "Filzung"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/B5D998> a skos:Concept ;
  skos:notation "B5D998" ;
