<https://www.w3id.org/archlink/terms/conservationthesaurus/F9C118> a skos:Concept ;
  skos:notation "F9C118" ;
  skos:prefLabel "Lochkorrosion"@de, "pitting corrosion"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AF5B1A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAC996>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A7B171>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AF5B1A> ;
  skos:definition "Bildung von lokalen, punktuellen Vertiefungen oder Löchern auf der Oberfläche eines Objektes, die durch chemische Reaktionen in einem korrosiven Umfeld entstehen. Diese Korrosionserscheinung schwächt das Material lokalisiert und kann zu strukturellen Schäden führen, insbesondere wenn sie unbehandelt bleibt."@de, [
    skosxl:literalForm "Bildung von lokalen, punktuellen Vertiefungen oder Löchern auf der Oberfläche eines Objektes, die durch chemische Reaktionen in einem korrosiven Umfeld entstehen. Diese Korrosionserscheinung schwächt das Material lokalisiert und kann zu strukturellen Schäden führen, insbesondere wenn sie unbehandelt bleibt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Lochkorrosion"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "pitting corrosion"@en ;
    wikibase:rank "normal"
  ] ;
  skos:altLabel "Lochfraßkorrosion"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Lochfraßkorrosion"@de ;
    wikibase:rank "preferred"
  ] .

