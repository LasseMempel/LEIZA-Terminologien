  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CD3341>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F3G8D1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9A858>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DFG875>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7DD6B> ;
  skos:definition "Holz der Linde, mit einer hellen, weißlich, gelblichen bis rötlichen Färbung, mit unter auch leicht bräunlich oder grünlich gestreift oder gefleckt. Das weiche Holz lässt sich besonders gut schnitzen und drechseln und wird daher häufig für die Bildhauerei sowie für Schnitz- und Drechselarbeiten im Modellbau verwendet."@de, [
    skosxl:literalForm "Holz der Linde, mit einer hellen, weißlich, gelblichen bis rötlichen Färbung, mit unter auch leicht bräunlich oder grünlich gestreift oder gefleckt. Das weiche Holz lässt sich besonders gut schnitzen und drechseln und wird daher häufig für die Bildhauerei sowie für Schnitz- und Drechselarbeiten im Modellbau verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
