  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/BF7D14> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BF7D14>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A82D86>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B5DD1A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F9GB13>, <https://www.w3id.org/archlink/terms/conservationthesaurus/FAG415>, <https://www.w3id.org/archlink/terms/conservationthesaurus/FGB415>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G> ;
  skos:definition "Legierung aus Kupfer und Zinn, die je nach Gewichtsanteil der beiden Bestandteile unterschiedliche Eigenschaften aufweisen kann. Zinnbronzen mit hÃ¶herem Kupfergehalt und Zinngehalten bis ca. 10% zeichenen sich durch eine gute Festigkeit und Umformbarkeit (HÃ¤mmer-, Walz und Schmiedbarkeit) aus, wÃ¤hrend Zinnbronzen mit einem hÃ¶heren Zinngehalt an HÃ¤rte und Dehnbarkeit aber auch SprÃ¶digkeit zunehmen und daher hauptsÃ¤chlich als Gusswerkstoff verwendet werden."@de, [
    skosxl:literalForm "Legierung aus Kupfer und Zinn, die je nach Gewichtsanteil der beiden Bestandteile unterschiedliche Eigenschaften aufweisen kann. Zinnbronzen mit hÃ¶herem Kupfergehalt und Zinngehalten bis ca. 10% zeichenen sich durch eine gute Festigkeit und Umformbarkeit (HÃ¤mmer-, Walz und Schmiedbarkeit) aus, wÃ¤hrend Zinnbronzen mit einem hÃ¶heren Zinngehalt an HÃ¤rte und Dehnbarkeit aber auch SprÃ¶digkeit zunehmen und daher hauptsÃ¤chlich als Gusswerkstoff verwendet werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
