<https://www.w3id.org/archlink/terms/conservationthesaurus/C2DF6G> a skos:Concept ;
  skos:notation "C2DF6G" ;
  skos:prefLabel "Fourier-Transform-Infrarotspektrometrie"@de, "fourier transform infrared spectroscopy"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/G17B8B> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D4A13D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G9B788>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G17B8B> ;
  skos:definition "analytische Methode, die zur Identifizierung und Charakterisierung von organischen und anorganischen Verbindungen verwendet wird. Das Prinzip beruht auf der Interferenz von Strahlung zwischen zwei Lichtstrahlen, bei der die Änderung der Weglänge zwischen den beiden Strahlen in Form eines Signals (Interferogram) gemessen und als Infrarotspektrum am Computer ausgewertet werden kann. Dieses gibt Auskunft über die molekulare Struktur und chemische Zusammensetzung einer Probe."@de, [
    skosxl:literalForm "analytische Methode, die zur Identifizierung und Charakterisierung von organischen und anorganischen Verbindungen verwendet wird. Das Prinzip beruht auf der Interferenz von Strahlung zwischen zwei Lichtstrahlen, bei der die Änderung der Weglänge zwischen den beiden Strahlen in Form eines Signals (Interferogram) gemessen und als Infrarotspektrum am Computer ausgewertet werden kann. Dieses gibt Auskunft über die molekulare Struktur und chemische Zusammensetzung einer Probe."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Fourier-Transform-Infrarotspektrometrie"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "fourier transform infrared spectroscopy"@en ;
    wikibase:rank "normal"
  ] ;
  skos:altLabel "FTIR"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "FTIR"@de ;
    wikibase:rank "preferred"
  ] .

