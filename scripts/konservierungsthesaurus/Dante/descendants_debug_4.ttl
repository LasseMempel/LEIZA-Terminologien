  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:definition "Umformverfahren, bei dem ein Werkstoff, meist Metall, durch die formgebende Öffnung eines Zieheisens gezogen wird. Dabei wird der Querschnitt des Materials verringert und seine Länge erhöht, ohne das Material zu trennen. Dieses Verfahren wird häufig zur Herstellung von Drähten, Rohren oder Profilen verwendet."@de, [
    skosxl:literalForm "Umformverfahren, bei dem ein Werkstoff, meist Metall, durch die formgebende Öffnung eines Zieheisens gezogen wird. Dabei wird der Querschnitt des Materials verringert und seine Länge erhöht, ohne das Material zu trennen. Dieses Verfahren wird häufig zur Herstellung von Drähten, Rohren oder Profilen verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "gezogen"@de ;
    wikibase:rank "preferred"
  ] ;
