<https://www.w3id.org/archlink/terms/conservationthesaurus/CDB814> a skos:Concept ;
  skos:notation "CDB814" ;
  skos:prefLabel "Diorit"@de, "diorite"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
