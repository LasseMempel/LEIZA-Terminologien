<https://www.w3id.org/archlink/terms/conservationthesaurus/B452DG> a skos:Concept ;
  skos:notation "B452DG" ;
  skos:prefLabel "Malachit"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/BGC9F3> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/GB6DF3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BGC9F3> ;
  skos:definition "sekundäres Kupfermineral mit der chemischen Zusammensetzung Cu2CO3(OH)2. Es gehört zur Gruppe der Carbonate mit Hydroxidionen und entsteht häufig als Verwitterungsprodukt von Kupfererzen in der Oxidationszone. Typisch für Malachit ist seine intensive grüne Farbe, die von hellgrün bis dunkelgrün variieren kann, sowie seine oft konzentrisch gebänderte oder massige Struktur. Es hat eine Mohs-Härte von 3,5–4 und wird seit der Antike für Schmuck, Dekoration und Pigmente verwendet."@de, [
    skosxl:literalForm "sekundäres Kupfermineral mit der chemischen Zusammensetzung Cu2CO3(OH)2. Es gehört zur Gruppe der Carbonate mit Hydroxidionen und entsteht häufig als Verwitterungsprodukt von Kupfererzen in der Oxidationszone. Typisch für Malachit ist seine intensive grüne Farbe, die von hellgrün bis dunkelgrün variieren kann, sowie seine oft konzentrisch gebänderte oder massige Struktur. Es hat eine Mohs-Härte von 3,5–4 und wird seit der Antike für Schmuck, Dekoration und Pigmente verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Malachit"@de ;
    wikibase:rank "preferred"
  ] .

