<https://www.w3id.org/archlink/terms/conservationthesaurus/G6841G> a skos:Concept ;
  skos:notation "G6841G" ;
  skos:prefLabel "geschliffen (Verzierungstechnik)"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:definition "spanabhebende Verzierungstechnik, bei der die Oberfläche eines Werkstückes gezielt mit Hilfe von Schleifwerkzeugen (Schleifmittelträger, auf dem eine Vielzahl von harten Schleifkörnern in gebundener oder loser Form aufgebracht sind) bearbeitet wird. Die scharfen, geometrisch unbestimmten Kanten und Schneiden der Schleifkörner tragen feine Späne von der Oberfläche des Materials ab und hinterlassen, je nach verwendetem Schleifwerkzeug, eine spezifische Oberflächenbeschaffenheit. Mit Hilfe rotierender Schleifkörper können dabei auch gezielte Formen und Muster in die Oberfläche eingeschliffen werden."@de, [
    skosxl:literalForm "spanabhebende Verzierungstechnik, bei der die Oberfläche eines Werkstückes gezielt mit Hilfe von Schleifwerkzeugen (Schleifmittelträger, auf dem eine Vielzahl von harten Schleifkörnern in gebundener oder loser Form aufgebracht sind) bearbeitet wird. Die scharfen, geometrisch unbestimmten Kanten und Schneiden der Schleifkörner tragen feine Späne von der Oberfläche des Materials ab und hinterlassen, je nach verwendetem Schleifwerkzeug, eine spezifische Oberflächenbeschaffenheit. Mit Hilfe rotierender Schleifkörper können dabei auch gezielte Formen und Muster in die Oberfläche eingeschliffen werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "geschliffen (Verzierungstechnik)"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "beschliffen"@de, "eingeschliffen"@de ;
