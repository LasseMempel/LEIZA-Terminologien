<https://www.w3id.org/archlink/terms/conservationthesaurus/G45985> a skos:Concept ;
  skos:notation "G45985" ;
  skos:prefLabel "gezogen"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
