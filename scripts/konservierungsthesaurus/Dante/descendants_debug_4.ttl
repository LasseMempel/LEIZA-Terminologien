    wikibase:rank "normal"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Cannelébindung"@de ;
    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/CB19D3> a skos:Concept ;
  skos:notation "CB19D3" ;
  skos:prefLabel "Irdenware"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DG279C> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/A11ACA>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GB6DF3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DG279C> ;
  skos:definition "keramische Materialgruppe mit porösen, meist erdfarbenen Scherben, die bei vergleichsweise niedrigen Temperaturen (ca. 600- 1100°C) gebrannt wird. Aufgrund der niedrigen Brenntemperatur und der daraus resultierenden Offenporigkeit, zeigt Irdenware eine relativ hohe Wasseraufnahmefähigkeit. Aus diesem Grund wird sie häufig mit Engoben oder Glasuren versehen, um die Oberfläche zu verdichten und die Verwendungseigenschaften zu verbessern. Irdenware umfasst verschiedene Keramikwaren wie Terrakotta, Fayence oder Majolika."@de, [
    skosxl:literalForm "keramische Materialgruppe mit porösen, meist erdfarbenen Scherben, die bei vergleichsweise niedrigen Temperaturen (ca. 600- 1100°C) gebrannt wird. Aufgrund der niedrigen Brenntemperatur und der daraus resultierenden Offenporigkeit, zeigt Irdenware eine relativ hohe Wasseraufnahmefähigkeit. Aus diesem Grund wird sie häufig mit Engoben oder Glasuren versehen, um die Oberfläche zu verdichten und die Verwendungseigenschaften zu verbessern. Irdenware umfasst verschiedene Keramikwaren wie Terrakotta, Fayence oder Majolika."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Irdenware"@de ;
    wikibase:rank "preferred"
  ] .

