  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C84834> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/GB6DF3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C84834>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BGC9F3> ;
  skos:definition "in verschiedenen Farben vorkommende Quarzvarietät, aus parallel gewachsenen, faserigen Kristallen von mikroskopischer und submikroskopischer Größe. Häufig finden sich auch Beimengungen von Moganite zwischen 1% - 20%, die sich jedoch im Laufe der Zeit zu Quarz umwandeln können, sodass ein moganite-freier Calcedon entsteht."@de, [
    skosxl:literalForm "in verschiedenen Farben vorkommende Quarzvarietät, aus parallel gewachsenen, faserigen Kristallen von mikroskopischer und submikroskopischer Größe. Häufig finden sich auch Beimengungen von Moganite zwischen 1% - 20%, die sich jedoch im Laufe der Zeit zu Quarz umwandeln können, sodass ein moganite-freier Calcedon entsteht."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/B97F4A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BBA96A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C5322D> ;
