<https://www.w3id.org/archlink/terms/conservationthesaurus/DF7759> a skos:Concept ;
  skos:notation "DF7759" ;
  skos:prefLabel "graviert"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D> ;
  skos:definition "Verzierungstechnik, bei der Muster, Schriften oder Motive durch das Herausschneiden von Material aus der Oberfläche eines Werkstücks angefertigt werden. Diese Vertiefungen werden mithilfe von Sticheln erzeugt, wobei die Stichelspitze dabei einem spanabhebenden Keil entspricht. Dieser wird in einem schrägen Winkel auf das Metall aufgesetzt und mit Handkraft in das Metall eingedrückt sowie gleichzeitig vorwäts geschoben. Zur Erzeugung unterschiedlicher Furchen kommen Stichel unterschiedlicher Form und Breite zum Einsatz."@de, [
    skosxl:literalForm "Verzierungstechnik, bei der Muster, Schriften oder Motive durch das Herausschneiden von Material aus der Oberfläche eines Werkstücks angefertigt werden. Diese Vertiefungen werden mithilfe von Sticheln erzeugt, wobei die Stichelspitze dabei einem spanabhebenden Keil entspricht. Dieser wird in einem schrägen Winkel auf das Metall aufgesetzt und mit Handkraft in das Metall eingedrückt sowie gleichzeitig vorwäts geschoben. Zur Erzeugung unterschiedlicher Furchen kommen Stichel unterschiedlicher Form und Breite zum Einsatz."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "graviert"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Gravierung"@de, "Gravur"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Gravur"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Gravierung"@de ;
    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/F646B4> a skos:Concept ;
  skos:notation "F646B4" ;
  skos:prefLabel "Granit"@de, "granite"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DF7826> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/GB6DF3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D866AD>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DF7826> ;
  skos:definition "körniges Tiefengestein mit Quarzanteil von mehr als 20% und weiteren Bestandteilen aus Feldspat, Biotit und Hornblende. Die Farbigkeit wird allgemein als Hell beschrieben, wobei je nach mineralogischer Zusammensetzungen Abstufungen zwischen weißlich-grau, über rose-rot bis dunkelgrau-schwarz sowie gesprenkelte oder geflecke Texturen zu beobachten sind."@de, [
    skosxl:literalForm "körniges Tiefengestein mit Quarzanteil von mehr als 20% und weiteren Bestandteilen aus Feldspat, Biotit und Hornblende. Die Farbigkeit wird allgemein als Hell beschrieben, wobei je nach mineralogischer Zusammensetzungen Abstufungen zwischen weißlich-grau, über rose-rot bis dunkelgrau-schwarz sowie gesprenkelte oder geflecke Texturen zu beobachten sind."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Granit"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "granite"@en ;
    wikibase:rank "normal"
  ] .

