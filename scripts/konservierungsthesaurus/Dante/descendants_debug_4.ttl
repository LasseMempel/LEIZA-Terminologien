    skosxl:literalForm "Ziehen"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G56825> a skos:Concept ;
  skos:notation "G56825" ;
  skos:prefLabel "gefräst"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:definition "spangebendes Fertigungsverfahren, bei dem Material von einem Werkstück durch die rotierende Bewegung eines mehrschneidigen Werkzeugs (Fräser) bei gleichzeitig verlaufender Vorschubbewegung abgetragen wird. Dabei kann der Fräser und/oder das Werkstück in verschiedenen Achsen bewegt werden, um komplexe Geometrien und Oberflächen herzustellen. Dieses Verfahren wird häufig zur Formgebung von Metallen, Kunststoffen und anderen Werkstoffen eingesetzt, wobei je nach Material und angestrebter Form unterschiedlich geformte Fräser eingesetzt werden."@de, [
    skosxl:literalForm "spangebendes Fertigungsverfahren, bei dem Material von einem Werkstück durch die rotierende Bewegung eines mehrschneidigen Werkzeugs (Fräser) bei gleichzeitig verlaufender Vorschubbewegung abgetragen wird. Dabei kann der Fräser und/oder das Werkstück in verschiedenen Achsen bewegt werden, um komplexe Geometrien und Oberflächen herzustellen. Dieses Verfahren wird häufig zur Formgebung von Metallen, Kunststoffen und anderen Werkstoffen eingesetzt, wobei je nach Material und angestrebter Form unterschiedlich geformte Fräser eingesetzt werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "gefräst"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Fräsen"@de, "Fräsung"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Fräsen"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Fräsung"@de ;
    wikibase:rank "normal"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G7497F> a skos:Concept ;
  skos:notation "G7497F" ;
  skos:prefLabel "geschliffen [Formgebung]"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AGG387> ;
  skos:definition "spanabhebendes Formungsverfahren, bei dem Material mit Hilfe von Schleifwerkzeugen (Schleifmittelträger, auf dem eine Vielzahl von harten Schleifkörnern in gebundener oder loser Form aufgebracht sind) von der Oberfläche eines Werkstücks entfernt wird. Dabei wirken die scharfen, geometrisch unbestimmten Kanten und Schneiden der Schleifkörner auf das Material ein und lösen dabei feine Späne ab. Dabei können mechanische Schleifmedien oder elektronisch rotierende Schleifwerkzeuge mit unterschiedlich groben/großen Schleifkörnern verwendet werden, je nach angestrebter Formgebung."@de, [
    skosxl:literalForm "spanabhebendes Formungsverfahren, bei dem Material mit Hilfe von Schleifwerkzeugen (Schleifmittelträger, auf dem eine Vielzahl von harten Schleifkörnern in gebundener oder loser Form aufgebracht sind) von der Oberfläche eines Werkstücks entfernt wird. Dabei wirken die scharfen, geometrisch unbestimmten Kanten und Schneiden der Schleifkörner auf das Material ein und lösen dabei feine Späne ab. Dabei können mechanische Schleifmedien oder elektronisch rotierende Schleifwerkzeuge mit unterschiedlich groben/großen Schleifkörnern verwendet werden, je nach angestrebter Formgebung."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "geschliffen [Formgebung]"@de ;
    wikibase:rank "preferred"
  ] ;
  skos:altLabel "Schleifen"@de, "Schliff"@de ;
  skosxl:altLabel [
    a skosxl:Label ;
    skosxl:literalForm "Schliff"@de ;
    wikibase:rank "preferred"
  ], [
    a skosxl:Label ;
    skosxl:literalForm "Schleifen"@de ;
    wikibase:rank "normal"
  ] .

