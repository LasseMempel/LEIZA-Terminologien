<https://www.w3id.org/archlink/terms/conservationthesaurus/B5C86F> a skos:Concept ;
  skos:notation "B5C86F" ;
  skos:prefLabel "Pappelholz"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/B51DAF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD172G>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CD3341>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F3G8D1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9A858>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DFG875>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7DD6B> ;
  skos:definition "Holz der Pappel, mit weißlich, gelblich bis hell-grün-bräunlicher Färbung, in Marknähe auch rötlich. Pappelholz ist ein sehr leichtes und weiches Holz, das sich gut mit verschiedenen Werkzeugen bearbeiten lässt. Bei Pappelholz ist es dabei besonders wichtig scharf geschliffene Werkzeuge zu verwenden, da die Oberfläche durch Reaktionsholzbildung oft filzig und rauh erscheinen kann. Aufgrund seiner geringen Festigkeit und der mittelmäßigen Dauerhaftigkeit/Witterungsbeständigkeit wird Pappelholz vor allem als Funierholz für Sperrholzprodukte oder als Konstruktionsholz geringer bis mittlerer Belastung im Innenbereich verwendet."@de, [
    skosxl:literalForm "Holz der Pappel, mit weißlich, gelblich bis hell-grün-bräunlicher Färbung, in Marknähe auch rötlich. Pappelholz ist ein sehr leichtes und weiches Holz, das sich gut mit verschiedenen Werkzeugen bearbeiten lässt. Bei Pappelholz ist es dabei besonders wichtig scharf geschliffene Werkzeuge zu verwenden, da die Oberfläche durch Reaktionsholzbildung oft filzig und rauh erscheinen kann. Aufgrund seiner geringen Festigkeit und der mittelmäßigen Dauerhaftigkeit/Witterungsbeständigkeit wird Pappelholz vor allem als Funierholz für Sperrholzprodukte oder als Konstruktionsholz geringer bis mittlerer Belastung im Innenbereich verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Pappelholz"@de ;
    wikibase:rank "preferred"
  ] ;
