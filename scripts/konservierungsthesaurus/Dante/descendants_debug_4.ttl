<https://www.w3id.org/archlink/terms/conservationthesaurus/C26D24> a skos:Concept ;
  skos:notation "C26D24" ;
  skos:prefLabel "genäht"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A15F83> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A15F83>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F8F594>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2> ;
  skos:definition "Fügetechnik, bei der zwei oder mehr Materialien mit Hilfe eines fortlaufenden Fadens und eines spitzen Werkzeugs (z.B. Nadel) durch mehrmaliges Durchstechen miteinander verbunden werden. Die Technik erzeugt eine Naht, die nicht nur funktionale sondern auch dekorative Zwecke erfüllen kann."@de, [
    skosxl:literalForm "Fügetechnik, bei der zwei oder mehr Materialien mit Hilfe eines fortlaufenden Fadens und eines spitzen Werkzeugs (z.B. Nadel) durch mehrmaliges Durchstechen miteinander verbunden werden. Die Technik erzeugt eine Naht, die nicht nur funktionale sondern auch dekorative Zwecke erfüllen kann."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
