<https://www.w3id.org/archlink/terms/conservationthesaurus/CG8188> a skos:Concept ;
  skos:notation "CG8188" ;
  skos:prefLabel "Zellenemail"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:definition "Emailtechnik, bei der auf eine Grundplatte mit einem flachgewalzten, hochkant stehenden Draht Muster und Formen gebildet und mit Tragantlösung aufgeklebt oder mit Emaillot festgelötet werden. Die dadurch gebildeten Zellen werden anschließend als einzelne Farbflächen mit Email gefüllt. Im Unterschied zum Stegemail wird die über die Emailfläche herausstehende Drahtkante (Stege) bis auf die Ebene des Emails heruntergearbeitet, sodass eine ebene, geschlossene Fläche entsteht."@de, [
    skosxl:literalForm "Emailtechnik, bei der auf eine Grundplatte mit einem flachgewalzten, hochkant stehenden Draht Muster und Formen gebildet und mit Tragantlösung aufgeklebt oder mit Emaillot festgelötet werden. Die dadurch gebildeten Zellen werden anschließend als einzelne Farbflächen mit Email gefüllt. Im Unterschied zum Stegemail wird die über die Emailfläche herausstehende Drahtkante (Stege) bis auf die Ebene des Emails heruntergearbeitet, sodass eine ebene, geschlossene Fläche entsteht."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Zellenemail"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D27B9A> a skos:Concept ;
  skos:notation "D27B9A" ;
  skos:prefLabel "Emailmalerei"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:definition "Emailtechnik, bei der auf einer mit opak-weißem Email überzogenen Grundfläche mit Metalloxidfarben ein Motiv aufgemalt wird. Durch den Brand im Ofen verbinden sich die Metalloxide mit der Glasmasse des Grundemails. Häufig wird abschließend noch eine dünne Schicht eines durchsichtigen Emails als Glasurüberzug aufgebracht."@de, [
    skosxl:literalForm "Emailtechnik, bei der auf einer mit opak-weißem Email überzogenen Grundfläche mit Metalloxidfarben ein Motiv aufgemalt wird. Durch den Brand im Ofen verbinden sich die Metalloxide mit der Glasmasse des Grundemails. Häufig wird abschließend noch eine dünne Schicht eines durchsichtigen Emails als Glasurüberzug aufgebracht."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Emailmalerei"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/DA226G> a skos:Concept ;
  skos:notation "DA226G" ;
  skos:prefLabel "Grubenemail"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:definition "Emailtechnik, bei der in eine Grundplatte Vertiefungen (Gruben) eingebracht und anschließend mit Email gefüllt werden. Die Vertiefungen können dabei durch Gravieren, Meißeln, Ätzen, Feile oder andere materialabtragende Techniken erzeugt werden."@de, [
    skosxl:literalForm "Emailtechnik, bei der in eine Grundplatte Vertiefungen (Gruben) eingebracht und anschließend mit Email gefüllt werden. Die Vertiefungen können dabei durch Gravieren, Meißeln, Ätzen, Feile oder andere materialabtragende Techniken erzeugt werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Grubenemail"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/FB5C1F> a skos:Concept ;
  skos:notation "FB5C1F" ;
  skos:prefLabel "Fensteremail"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:definition "Emailtechnik, bei der Emailschichten in Aussparungen durchbrochener Grundplatten oder in die Zwischenräume aus Stegen montierter Ornamente eingefüllt werden. Als Hinterlegung dienen Glimmer- oder dünne Metallfolien während des Schmelzvorganges, die im Anschluss von der Rückseite entfernt oder abgeschliffen werden. Die auf diese Weise entstehenden Werkstücke erinnern an farbige Fenster, die bei hindurchfallendem Licht eine prächtige leuchtende Optik zeigen."@de, [
    skosxl:literalForm "Emailtechnik, bei der Emailschichten in Aussparungen durchbrochener Grundplatten oder in die Zwischenräume aus Stegen montierter Ornamente eingefüllt werden. Als Hinterlegung dienen Glimmer- oder dünne Metallfolien während des Schmelzvorganges, die im Anschluss von der Rückseite entfernt oder abgeschliffen werden. Die auf diese Weise entstehenden Werkstücke erinnern an farbige Fenster, die bei hindurchfallendem Licht eine prächtige leuchtende Optik zeigen."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Fensteremail"@de ;
    wikibase:rank "preferred"
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G1A3FB> a skos:Concept ;
  skos:notation "G1A3FB" ;
  skos:prefLabel "Stegemail"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/BC5B57>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4BCF8>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CA1BC5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D6BCC2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F2244D>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B14C4A> ;
  skos:definition "Emailtechnik ähnlich dem Zellenemail. Auf eine Grundplatte werden flachgewalzte Drahtstücke hochkant stehend zu einem Muster gelegt und mit Tragantlösung aufgeklebt bzw. bei komplexeren Formen aufgelötet. Die durch diese Stege entstehenden Zellen werden mit Email gefüllt. Im Gegensatz zum Zellenemail bleiben die überstehenden Stege beim Stegemail erhalten und werden nicht auf die Ebene des Emails abgeschliffen."@de, [
    skosxl:literalForm "Emailtechnik ähnlich dem Zellenemail. Auf eine Grundplatte werden flachgewalzte Drahtstücke hochkant stehend zu einem Muster gelegt und mit Tragantlösung aufgeklebt bzw. bei komplexeren Formen aufgelötet. Die durch diese Stege entstehenden Zellen werden mit Email gefüllt. Im Gegensatz zum Zellenemail bleiben die überstehenden Stege beim Stegemail erhalten und werden nicht auf die Ebene des Emails abgeschliffen."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    skosxl:literalForm "Stegemail"@de ;
    wikibase:rank "preferred"
  ] ;
