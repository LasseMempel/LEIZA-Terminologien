<https://www.w3id.org/archlink/terms/conservationthesaurus/DAA3F9> a skos:Concept ;
  skos:notation "DAA3F9" ;
  skos:prefLabel "zerstreutporiges Laubholz"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
