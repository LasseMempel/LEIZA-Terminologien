<https://www.w3id.org/archlink/terms/conservationthesaurus/B77A8F> a skos:Concept ;
  skos:notation "B77A8F" ;
  skos:prefLabel "Ethylacetat"@de, "ethyl acetate"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Essigester"@de, "Essigsäureethylester"@de, "Ethansäureethylester"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "flüchtiges, farbloses Lösungsmittel aus der Gruppe der Carbonsäureester, welches in der Lage ist verschiedene organische Stoffe, wie Polymere, zu lösen bzw. Lösungen einzugehen. Es verdunstet relativ langsam, hinterlässt kaum Rückstände und ist im Verhältnis zu anderen Lösungsmitteln weniger toxisch, wobei dennoch akute Gesundheitsgefahren von diesem Stoff ausgehen! In der Konservierung und Restaurierung wird Ethylacetat häufig als Ersatz für das hochgiftige Toluol verwendet, da es sich ähnlich langsam verflüchtigt und somit bei der Festigung instabiler Materialien zu einer ähnlich guten Eindringtiefe gelöster Polymere führt."@de, [
    skosxl:literalForm "flüchtiges, farbloses Lösungsmittel aus der Gruppe der Carbonsäureester, welches in der Lage ist verschiedene organische Stoffe, wie Polymere, zu lösen bzw. Lösungen einzugehen. Es verdunstet relativ langsam, hinterlässt kaum Rückstände und ist im Verhältnis zu anderen Lösungsmitteln weniger toxisch, wobei dennoch akute Gesundheitsgefahren von diesem Stoff ausgehen! In der Konservierung und Restaurierung wird Ethylacetat häufig als Ersatz für das hochgiftige Toluol verwendet, da es sich ähnlich langsam verflüchtigt und somit bei der Festigung instabiler Materialien zu einer ähnlich guten Eindringtiefe gelöster Polymere führt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Essigsäureethylester"@de
  ], [
