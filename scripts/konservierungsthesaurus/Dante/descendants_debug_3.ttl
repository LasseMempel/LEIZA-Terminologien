    skosxl:literalForm "Siedegrenzbenzin"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "white spirit"@en
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> a skos:Concept ;
  skos:notation "C421BF" ;
  skos:prefLabel "Lösungsmittel"@de, "solvent"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Lösemittel"@de, "Reinigungsmittel"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1> ;
  skos:definition "Substanz, die in der Lage ist andere Stoffe (Feststoffe, Flüssigkeiten oder Gase) zu lösen, ohne dabei selbst eine chemische Reaktion mit diesem Stoff einzugehen. Das Lösungsmittel bildet eine homogene Mischung (Lösung) mit dem gelösten Stoff, in der die Moleküle des gelösten Stoffes in der Matrix des Lösemittels fein verteilt sind. Diese Stoffe werden in der Konservierung/Restaurierung als Reinigungsmittel für die Entfernung unerwünschter Substanzen von/aus einem Objekt verwendet und gleichzeitig auch als Lösungsmittel von Polymeren für die Herstellung lösemittelbasierter Klebstoffe bzw. Lacke."@de, [
    skosxl:literalForm "Substanz, die in der Lage ist andere Stoffe (Feststoffe, Flüssigkeiten oder Gase) zu lösen, ohne dabei selbst eine chemische Reaktion mit diesem Stoff einzugehen. Das Lösungsmittel bildet eine homogene Mischung (Lösung) mit dem gelösten Stoff, in der die Moleküle des gelösten Stoffes in der Matrix des Lösemittels fein verteilt sind. Diese Stoffe werden in der Konservierung/Restaurierung als Reinigungsmittel für die Entfernung unerwünschter Substanzen von/aus einem Objekt verwendet und gleichzeitig auch als Lösungsmittel von Polymeren für die Herstellung lösemittelbasierter Klebstoffe bzw. Lacke."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/G34563>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AFC696>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DFD1B7>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B77A8F>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BBA28A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BDG3D5>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D347D6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D627B2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D72F3A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G46243>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GGD87G> ;
  skosxl:altLabel [
