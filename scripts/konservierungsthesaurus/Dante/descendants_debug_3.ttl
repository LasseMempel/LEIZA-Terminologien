<https://www.w3id.org/archlink/terms/conservationthesaurus/A5D92A> a skos:Concept ;
  skos:notation "A5D92A" ;
  skos:prefLabel "Ammoniak"@de, "ammonia"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "NH3"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A2B746> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A2B746> ;
  skos:definition "leicht flüchtige, alkalische Verbindung, die in der Konservierung/Restaurierung für die Entfernung von Verfärbungen durch Kupfer oder für die Entfernung von Shellack verwendet wird. Die stark basische Substanz löst besonders Fette, Öle und oxidierte Schutzlacke. Aufgrund der ätzenden Wirkung und gesundheitsgefährdenden Dämpfen ist bei der Anwendung besondere Vorsicht geboten."@de, [
    skosxl:literalForm "leicht flüchtige, alkalische Verbindung, die in der Konservierung/Restaurierung für die Entfernung von Verfärbungen durch Kupfer oder für die Entfernung von Shellack verwendet wird. Die stark basische Substanz löst besonders Fette, Öle und oxidierte Schutzlacke. Aufgrund der ätzenden Wirkung und gesundheitsgefährdenden Dämpfen ist bei der Anwendung besondere Vorsicht geboten."@de
  ] ;
