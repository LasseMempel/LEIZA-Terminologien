    skosxl:literalForm "vollentsalztes Wasser"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Demineralisiertes Wasser"@de
  ] .

