<https://www.w3id.org/archlink/terms/conservationthesaurus/AFF6GA> a skos:Concept ;
  skos:notation "AFF6GA" ;
  skos:prefLabel "Paraloid B44"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/GFD582> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GFD582>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A1D125>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1> ;
  skos:definition "Produktname eines synthetischen Acrylharzes der Firma Rohm und Haas (heute Teil von Dow Chemicals) auf Basis von Methylmethacrylat und Ethylacrylat sowie einem geringem Anteil Butylmethacrylat. Ähnlich wie Paraloid B72 zeigt es gute Alterungsbeständigkeit, Transparenz und Reversibilität, ist in verschiedenen organischen Lösungsmitteln löslich und wird als Klebstoff, Bindemittel, Festigungsmittel und für Schutzüberzüge verwendet. Im Gegensatz zu Paraloid B72 besitzt es eine höhere Glasübergangstemperatur (ca. 60°C), wodurch Paraloid B44 besonders für die Verwendung in wärmeren Umgebungen geeignet ist."@de, [
    skosxl:literalForm "Produktname eines synthetischen Acrylharzes der Firma Rohm und Haas (heute Teil von Dow Chemicals) auf Basis von Methylmethacrylat und Ethylacrylat sowie einem geringem Anteil Butylmethacrylat. Ähnlich wie Paraloid B72 zeigt es gute Alterungsbeständigkeit, Transparenz und Reversibilität, ist in verschiedenen organischen Lösungsmitteln löslich und wird als Klebstoff, Bindemittel, Festigungsmittel und für Schutzüberzüge verwendet. Im Gegensatz zu Paraloid B72 besitzt es eine höhere Glasübergangstemperatur (ca. 60°C), wodurch Paraloid B44 besonders für die Verwendung in wärmeren Umgebungen geeignet ist."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Paraloid B44"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/AG2965> a skos:Concept ;
  skos:notation "AG2965" ;
  skos:prefLabel "natürliches Polymer"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Naturharz"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1> ;
  skos:definition "Oberbegriff für Polymere, die aus natürlichen Quellen stammen, leicht bis garnicht synthetisch modifiziert wurden und vielseitig einsetzbar sind. Diese Stoffe wurden vor allem in den Anfängen der Restaurierungsgeschichte, bevor synthetische Polymere in breiter Bandbreite zur Verfügung standen, häufig zum Kleben und Stabilisieren von Objekten eingesetzt. In der modernen Restaurierung spielen sie eher eine untergeordnete Rollen, finden jedoch nach wie vor vereinzelt Verwendung."@de, [
    skosxl:literalForm "Oberbegriff für Polymere, die aus natürlichen Quellen stammen, leicht bis garnicht synthetisch modifiziert wurden und vielseitig einsetzbar sind. Diese Stoffe wurden vor allem in den Anfängen der Restaurierungsgeschichte, bevor synthetische Polymere in breiter Bandbreite zur Verfügung standen, häufig zum Kleben und Stabilisieren von Objekten eingesetzt. In der modernen Restaurierung spielen sie eher eine untergeordnete Rollen, finden jedoch nach wie vor vereinzelt Verwendung."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/C176FC> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Naturharz"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "natürliches Polymer"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/C176FC> a skos:Concept ;
  skos:notation "C176FC" ;
  skos:prefLabel "Schellack"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/AG2965> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/AG2965> ;
  skos:definition "Ausscheidungssekret der Lackschildlaus, welcher in Alkohol gelöst zu einer streichbaren Konsistenz verarbeitet werden kann. Nach der Verflüchtigung des Alkohols trocknet Shellack zu einer dicken, dunkelbraunen Schicht die im Laufe der Zeit durch Alterungsprozesse (cross-linking) zu einer praktisch unlöslichen Masse polymerisiert. Aus chemischer Sicht handelt es sich bei Shellack um ein Polyester aus den Hauptbestandteilen Aleursäure, Aldehyde und andere Carboxylsäuren."@de, [
    skosxl:literalForm "Ausscheidungssekret der Lackschildlaus, welcher in Alkohol gelöst zu einer streichbaren Konsistenz verarbeitet werden kann. Nach der Verflüchtigung des Alkohols trocknet Shellack zu einer dicken, dunkelbraunen Schicht die im Laufe der Zeit durch Alterungsprozesse (cross-linking) zu einer praktisch unlöslichen Masse polymerisiert. Aus chemischer Sicht handelt es sich bei Shellack um ein Polyester aus den Hauptbestandteilen Aleursäure, Aldehyde und andere Carboxylsäuren."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/B2F4F2>, <https://www.w3id.org/archlink/terms/conservationthesaurus/BA71DA>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C143C4>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C4AG61>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D769C3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G379BF>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GC7994>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GD86C1> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Schellack"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/B15G98> a skos:Concept ;
  skos:notation "B15G98" ;
  skos:prefLabel "Kallocryl"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/GFD582> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/GFD582>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A1D125>, <https://www.w3id.org/archlink/terms/conservationthesaurus/B7B8B6>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1> ;
  skos:definition "Produktname eines synthetischen Acrylharzes der Firma SPEIKO - Spezialitäten GmbH, auf Basis von Polymethylmethacrylat (PMMA). Es zeigt ähnliche Eigenschaften wie Paraloid B72, ist jedoch etwas härter und besitzt eine höhere Glasübergangstemperatur (ca. 50-60°C). Kallocryl wurde ursprünglich für den Dentalbereich, für die Erstellung von Prothesen entiwckelt und ist daher für Anwendungen im Bereich der Konservierung/Restaurierung noch nicht soweit erforscht wie andere PMMA basierte Polymere."@de, [
    skosxl:literalForm "Produktname eines synthetischen Acrylharzes der Firma SPEIKO - Spezialitäten GmbH, auf Basis von Polymethylmethacrylat (PMMA). Es zeigt ähnliche Eigenschaften wie Paraloid B72, ist jedoch etwas härter und besitzt eine höhere Glasübergangstemperatur (ca. 50-60°C). Kallocryl wurde ursprünglich für den Dentalbereich, für die Erstellung von Prothesen entiwckelt und ist daher für Anwendungen im Bereich der Konservierung/Restaurierung noch nicht soweit erforscht wie andere PMMA basierte Polymere."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Kallocryl"@de
  ] .

