<https://www.w3id.org/archlink/terms/conservationthesaurus/CB4G84> a skos:Concept ;
  skos:notation "CB4G84" ;
  skos:prefLabel "Wachs"@de, "wax"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DG8FG3> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DG8FG3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/FBFFF5> ;
  skos:definition "weich, plastisches Material aus unterschiedlichen Stoffgemischen mit niedrigem Schmelzpunkt und guter Adhäsionsfähigkeit. In der Konservierung und Restaurierung wird Wachs unter anderem für die Ergänzung von Fehlstellen, als Abformmaterial bzw. als Manschette oder als Material für das freie Modellieren des fehlenden Teils, verwendet. Darüber hinaus werden modifizierte Wachse als Trennschicht bzw. Absperrschicht zwischen Materialien und als Versiegelung poröser Materialien eingesetzt."@de, [
    skosxl:literalForm "weich, plastisches Material aus unterschiedlichen Stoffgemischen mit niedrigem Schmelzpunkt und guter Adhäsionsfähigkeit. In der Konservierung und Restaurierung wird Wachs unter anderem für die Ergänzung von Fehlstellen, als Abformmaterial bzw. als Manschette oder als Material für das freie Modellieren des fehlenden Teils, verwendet. Darüber hinaus werden modifizierte Wachse als Trennschicht bzw. Absperrschicht zwischen Materialien und als Versiegelung poröser Materialien eingesetzt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/C9AFG9>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F777B3> ;
