    skosxl:literalForm "turpentine"@en
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D627B2> a skos:Concept ;
  skos:notation "D627B2" ;
  skos:prefLabel "Toloul"@de, "toluene"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Methylbenzol"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "aromatischer Kohlenwasserstoff und organisches, unpolares Lösungsmittel mit der chemischen Summenformel C7H8, das in der Konservierung und Restaurierung zur Entfernung von Wachsen, Ölen, Harzen und Polymeren von/aus Objekten sowie zur Herstellung von Polymerlösungen verwendet wird. Toluol ist höchst gesundheitsgefährdent, sodass seine Verwendung auf ein Minium beschränkt und nach Möglichkeiten auf weniger gefährliche Alternativen zurückgegriffen werden sollte. Toluol ist eng verwandt mit Xylol, zeigt jedoch eine höhere Flüchtigkeit und eine geringfügig bessere Lösungskraft aufgrund der etwas höheren Polarität"@de, [
    skosxl:literalForm "aromatischer Kohlenwasserstoff und organisches, unpolares Lösungsmittel mit der chemischen Summenformel C7H8, das in der Konservierung und Restaurierung zur Entfernung von Wachsen, Ölen, Harzen und Polymeren von/aus Objekten sowie zur Herstellung von Polymerlösungen verwendet wird. Toluol ist höchst gesundheitsgefährdent, sodass seine Verwendung auf ein Minium beschränkt und nach Möglichkeiten auf weniger gefährliche Alternativen zurückgegriffen werden sollte. Toluol ist eng verwandt mit Xylol, zeigt jedoch eine höhere Flüchtigkeit und eine geringfügig bessere Lösungskraft aufgrund der etwas höheren Polarität"@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Methylbenzol"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Toloul"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "toluene"@en
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/D72F3A> a skos:Concept ;
  skos:notation "D72F3A" ;
  skos:prefLabel "Aceton"@de, "acetone"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "klare, charakteristisch aromatisch-süßlich riechende Flüssigkeit, die als weitverbreitestes organisches Lösungsmittel für eine Vielzahl an Polymeren, Fetten, Wachsen und Ölen verwendet wird. Aceton ist stark flüchtig und eignet sich aufgrund seiner schnellen Verdunstung und starken Lösungskraft sehr gut für gezielte Reinigungsarbeiten, ohne das zu behandelne Material zu stark zu durchfeuchten. Darüber hinaus wird es häufig für die Herstellung von Polymerlösungen für Klebungen, Tränkungen oder Schutzüberzüge verwendet. Aceton ist akut gesundheitsgefährdend und sollte stets mit den nötigen Sicherheitsvorkehrungen verwendet werden."@de, [
    skosxl:literalForm "klare, charakteristisch aromatisch-süßlich riechende Flüssigkeit, die als weitverbreitestes organisches Lösungsmittel für eine Vielzahl an Polymeren, Fetten, Wachsen und Ölen verwendet wird. Aceton ist stark flüchtig und eignet sich aufgrund seiner schnellen Verdunstung und starken Lösungskraft sehr gut für gezielte Reinigungsarbeiten, ohne das zu behandelne Material zu stark zu durchfeuchten. Darüber hinaus wird es häufig für die Herstellung von Polymerlösungen für Klebungen, Tränkungen oder Schutzüberzüge verwendet. Aceton ist akut gesundheitsgefährdend und sollte stets mit den nötigen Sicherheitsvorkehrungen verwendet werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Aceton"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "acetone"@en
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G46243> a skos:Concept ;
  skos:notation "G46243" ;
  skos:prefLabel "Propylacetat"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Essigsäurepropylester"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "farbloses, flüchtiges Lösungsmittel aus der Gruppe der Ester mit einem fruchtigen Geruch und der chemischen Formel C5H10O2. Es wird in der Konservierung und Restaurierung als Lösungsmittel für verschiedene organische Verbindungen eingesetzt, z.B. zur Herstellung von Kleb- oder Festigungsmitteln. Von dem Stoff gehen akute und chronische Gesundheitsgefahren aus, sodass bei dessen Verwendung die üblichen Sicherheitsvorkehrungen einzuhalten sind."@de, [
    skosxl:literalForm "farbloses, flüchtiges Lösungsmittel aus der Gruppe der Ester mit einem fruchtigen Geruch und der chemischen Formel C5H10O2. Es wird in der Konservierung und Restaurierung als Lösungsmittel für verschiedene organische Verbindungen eingesetzt, z.B. zur Herstellung von Kleb- oder Festigungsmitteln. Von dem Stoff gehen akute und chronische Gesundheitsgefahren aus, sodass bei dessen Verwendung die üblichen Sicherheitsvorkehrungen einzuhalten sind."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Essigsäurepropylester"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Propylacetat"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/GGD87G> a skos:Concept ;
  skos:notation "GGD87G" ;
  skos:prefLabel "Coloradol"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "Produktname eines Lösungsmittelgemisches der Firma Ehserchemie GmbH bestehen aus Dichlormethan und Methanol. Aufgrund des starken organischen Lösungsmittels Dichlormethan, dessen Effektivität von Methanol noch unterstützt wird, ist Coloradol in der Lage ausgehärtete Epoxidharze aufzulösen bzw. soweit zu schwächen, dass sie entfernt werden können. Entsprechend wird Coloradol für die Lösung bzw. Entfernung von Epoxidsharz-Klebungen verwendet. Allerdings gehen höchste Gesundheitsgefahren von den Bestandteilen des Coloradols aus, sodass dessen Verwendung auf ein Minimum begrenzt werden sollte."@de, [
    skosxl:literalForm "Produktname eines Lösungsmittelgemisches der Firma Ehserchemie GmbH bestehen aus Dichlormethan und Methanol. Aufgrund des starken organischen Lösungsmittels Dichlormethan, dessen Effektivität von Methanol noch unterstützt wird, ist Coloradol in der Lage ausgehärtete Epoxidharze aufzulösen bzw. soweit zu schwächen, dass sie entfernt werden können. Entsprechend wird Coloradol für die Lösung bzw. Entfernung von Epoxidsharz-Klebungen verwendet. Allerdings gehen höchste Gesundheitsgefahren von den Bestandteilen des Coloradols aus, sodass dessen Verwendung auf ein Minimum begrenzt werden sollte."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Coloradol"@de
  ] .

