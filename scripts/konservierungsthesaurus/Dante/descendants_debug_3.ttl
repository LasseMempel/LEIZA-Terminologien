  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/G34563> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G34563>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "farblos, klare Flüssigkeit die als hocharomatisches, unpolares Lösungsmittel fungiert und mit den meisten organischen Flüssigkeiten mischbar ist. In der Konservierung und Restaurierung wird es hauptsächlich als Lösungsmittel für viele Öle, Fette, Wachse und Natur- bzw. Kunstharze eingesetzt."@de, [
    skosxl:literalForm "farblos, klare Flüssigkeit die als hocharomatisches, unpolares Lösungsmittel fungiert und mit den meisten organischen Flüssigkeiten mischbar ist. In der Konservierung und Restaurierung wird es hauptsächlich als Lösungsmittel für viele Öle, Fette, Wachse und Natur- bzw. Kunstharze eingesetzt."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Shellsol A"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G34563> a skos:Concept ;
  skos:notation "G34563" ;
  skos:prefLabel "Siedegrenzbenzin"@de, "white spirit"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "Leichtbenzin"@de, "Reinigungsbenzin"@de, "Terpentinersatz"@de, "Waschbenzin"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C421BF> ;
  skos:definition "leichtflüchtige, klare Flüssigkeit mit charakteristisch benzinartigem Geruch. Je nach Produkt können unterschiedliche Zusammensetzungen aus aliphatischen und aromatischen Kohlenwasserstoffen enthalten sein, die zu spezifischen physikalischen und chemischen Eigenschaften führen. In der Restaurierung wird Siedegrenzbenzin aufgrund seiner Eigenschaften als unpolares Lösungsmittel zur Reinigung/Entfernung von apolaren Stoffen, zur Entfettung von Oberflächen, sowie zur Herstellung von Lösungen verwendet."@de, [
    skosxl:literalForm "leichtflüchtige, klare Flüssigkeit mit charakteristisch benzinartigem Geruch. Je nach Produkt können unterschiedliche Zusammensetzungen aus aliphatischen und aromatischen Kohlenwasserstoffen enthalten sein, die zu spezifischen physikalischen und chemischen Eigenschaften führen. In der Restaurierung wird Siedegrenzbenzin aufgrund seiner Eigenschaften als unpolares Lösungsmittel zur Reinigung/Entfernung von apolaren Stoffen, zur Entfettung von Oberflächen, sowie zur Herstellung von Lösungen verwendet."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skos:narrower <https://www.w3id.org/archlink/terms/conservationthesaurus/A32B47>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A7B4F9> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Reinigungsbenzin"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "Waschbenzin"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "Terpentinersatz"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "Leichtbenzin"@de
  ] ;
  skosxl:prefLabel [
    a skosxl:Label ;
