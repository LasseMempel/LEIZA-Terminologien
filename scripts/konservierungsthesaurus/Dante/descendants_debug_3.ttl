<https://www.w3id.org/archlink/terms/conservationthesaurus/CD536F> a skos:Concept ;
  skos:notation "CD536F" ;
  skos:prefLabel "Pinseltränkung"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A9FF5A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F37GBB>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D32A26>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G98FD4>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9FF5A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DA9CGG> ;
  skos:definition "Festigungsmethode, bei der ein sich in Lösung befindliches Polymer als Festigungsmittel auf die Oberfläche des Objektes aufgepinselt wird. Der Prozess wird nach Bedarf mehrfach wiederholt um den Sättigungsgrad der Tränkung und somit die stabilisierende Wirkung zu erhöhen. Bei dieser Methode ist eine sehr kontrollierte Einbringung des Festigungsmittels möglich, sodass auch nur gezielte Bereiche eines Objektes gefestigt werden können."@de, [
    skosxl:literalForm "Festigungsmethode, bei der ein sich in Lösung befindliches Polymer als Festigungsmittel auf die Oberfläche des Objektes aufgepinselt wird. Der Prozess wird nach Bedarf mehrfach wiederholt um den Sättigungsgrad der Tränkung und somit die stabilisierende Wirkung zu erhöhen. Bei dieser Methode ist eine sehr kontrollierte Einbringung des Festigungsmittels möglich, sodass auch nur gezielte Bereiche eines Objektes gefestigt werden können."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Pinseltränkung"@de
  ] .

<https://www.w3id.org/archlink/terms/conservationthesaurus/G3368F> a skos:Concept ;
  skos:notation "G3368F" ;
  skos:prefLabel "Pipettentränkung"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A9FF5A> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F37GBB>, <https://www.w3id.org/archlink/terms/conservationthesaurus/D32A26>, <https://www.w3id.org/archlink/terms/conservationthesaurus/G98FD4>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A9FF5A>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DA9CGG> ;
  skos:definition "Festigungsmethode, bei der ein sich in Lösung befindliches Polymere als Festigungsmittel mit Hilfe einer Pipette auf das Objekt aufgetropft wird. Die Anwendung kann dabei mehrfach wiederholt werden, um den Sättigungsgrad des Objektmaterials und somit die stabilisierende Wirkung zu erhöhen. Wie bei der Pinseltränkung ist ebenfalls eine große Kontrolle der Auftragung möglich und es können gezielt einzelne Bereiche gefestigt werden."@de, [
    skosxl:literalForm "Festigungsmethode, bei der ein sich in Lösung befindliches Polymere als Festigungsmittel mit Hilfe einer Pipette auf das Objekt aufgetropft wird. Die Anwendung kann dabei mehrfach wiederholt werden, um den Sättigungsgrad des Objektmaterials und somit die stabilisierende Wirkung zu erhöhen. Wie bei der Pinseltränkung ist ebenfalls eine große Kontrolle der Auftragung möglich und es können gezielt einzelne Bereiche gefestigt werden."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Pipettentränkung"@de
  ] .

