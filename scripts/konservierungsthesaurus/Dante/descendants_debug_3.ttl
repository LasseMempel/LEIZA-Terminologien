<https://www.w3id.org/archlink/terms/conservationthesaurus/A2B583> a skos:Concept ;
  skos:notation "A2B583" ;
  skos:prefLabel "Plastilin"@de, "plasticine"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/DG8FG3> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/DG8FG3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/FBFFF5> ;
  skos:definition "formbare ton- bzw. wachsähnliche Modelliermasse aus verschiedenen Füllstoffen (Kalziumcarbonat, Kreide, Kalk, etc.) Ölen, Wachsen und Polymeren. Sie trocknet nicht aus, bleibt dauerhaft geschmeidig und knetbar sowie wiedervervendbar. In der Konservierung und Restaurierung wird Plastilin häufig für temporäre Stützen, Abformungen und Manschettenergänzungen verwendet. Die enthaltenen Öle in manchen Plastilin-Produkten können, gerade auf hellen und/oder porösen Oberflächen, zu Verfärbungen, Flecken und fettigen Rückständen führen, sodass solche Oberfläche bei der Verwendung von Plastilin zusätzlich geschützt werden sollten."@de, [
    skosxl:literalForm "formbare ton- bzw. wachsähnliche Modelliermasse aus verschiedenen Füllstoffen (Kalziumcarbonat, Kreide, Kalk, etc.) Ölen, Wachsen und Polymeren. Sie trocknet nicht aus, bleibt dauerhaft geschmeidig und knetbar sowie wiedervervendbar. In der Konservierung und Restaurierung wird Plastilin häufig für temporäre Stützen, Abformungen und Manschettenergänzungen verwendet. Die enthaltenen Öle in manchen Plastilin-Produkten können, gerade auf hellen und/oder porösen Oberflächen, zu Verfärbungen, Flecken und fettigen Rückständen führen, sodass solche Oberfläche bei der Verwendung von Plastilin zusätzlich geschützt werden sollten."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:prefLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
    skosxl:literalForm "Plastilin"@de
  ], [
    a skosxl:Label ;
    wikibase:rank "normal" ;
    skosxl:literalForm "plasticine"@en
  ] .

