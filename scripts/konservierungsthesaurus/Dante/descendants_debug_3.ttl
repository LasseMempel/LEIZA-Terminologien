<https://www.w3id.org/archlink/terms/conservationthesaurus/BFA1CC> a skos:Concept ;
  skos:notation "BFA1CC" ;
  skos:prefLabel "Injektion"@de ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
