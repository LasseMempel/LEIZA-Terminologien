  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A13CD1> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/A13CD1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C79561>, <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/F37GBB> ;
  skos:definition "Methode zur vorübergehenden, nicht dauerhaften Zusammenfügung fragmentierter Objekte, um deren ursprüngliche Form, Konstruktion oder gestalterische Aspekte zu untersuchen oder zu dokumentieren."@de, [
    skosxl:literalForm "Methode zur vorübergehenden, nicht dauerhaften Zusammenfügung fragmentierter Objekte, um deren ursprüngliche Form, Konstruktion oder gestalterische Aspekte zu untersuchen oder zu dokumentieren."@de
  ] ;
