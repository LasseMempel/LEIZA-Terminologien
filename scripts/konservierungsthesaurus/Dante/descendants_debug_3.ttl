<https://www.w3id.org/archlink/terms/conservationthesaurus/GG3G4B> a skos:Concept ;
  skos:notation "GG3G4B" ;
  skos:prefLabel "Natriumhydroxid"@de, "sodium hydroxide"@en ;
  dct:created "2026-01-30"^^<xsd:date> ;
  dct:issued "2026-01-30"^^<xsd:date> ;
  dct:modified "2026-02-04"^^<xsd:date> ;
  dct:publisher [
    skos:prefLabel "Leibniz-Zentrum für Archäologie (LEIZA)"@de
  ] ;
  skos:altLabel "NaOH"@de, "Natronlauge"@de, "Ätznatron"@de ;
  skos:broader <https://www.w3id.org/archlink/terms/conservationthesaurus/A2B746> ;
  skos:broaderTransitive <https://www.w3id.org/archlink/terms/conservationthesaurus/CFGDA3>, <https://www.w3id.org/archlink/terms/conservationthesaurus/C364G1>, <https://www.w3id.org/archlink/terms/conservationthesaurus/A2B746> ;
  skos:definition "stark alkalische, hygroskopische Verbindung, die in der Kondervierung/Restaurierung hauptsächlich zur Reinigung und Entfettung von Oberflächen sowie für die Entsalzung archäologischer Eisenobjekte verwendet wird. Die stark basische Substanz löst organische Materialien wie Fette und Proteine und ist in der Lage Chloridionen aus Metallen zu extrahieren und in Lösung zu bringen. Die ätzende Wirkung erfordert strenge Sicherheitsmaßnahmen bei der Anwednung."@de, [
    skosxl:literalForm "stark alkalische, hygroskopische Verbindung, die in der Kondervierung/Restaurierung hauptsächlich zur Reinigung und Entfettung von Oberflächen sowie für die Entsalzung archäologischer Eisenobjekte verwendet wird. Die stark basische Substanz löst organische Materialien wie Fette und Proteine und ist in der Lage Chloridionen aus Metallen zu extrahieren und in Lösung zu bringen. Die ätzende Wirkung erfordert strenge Sicherheitsmaßnahmen bei der Anwednung."@de
  ] ;
  skos:inScheme <http://uri.gbv.de/terminology/leiza_archlink/> ;
  skosxl:altLabel [
    a skosxl:Label ;
    wikibase:rank "preferred" ;
